generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Mesario {
  id        String   @id @db.Uuid
  nome      String   @db.Text
  cpf       String   @db.Text
  zona      String?  @db.Text
  secao     String?  @db.Text
  createdAt DateTime @map("created_at") @db.Timestamptz(6)

  @@map("mesarios")
}
